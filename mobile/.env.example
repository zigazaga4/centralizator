# Copy to .env.local and fill in. Vite inlines these at build time.

# Server origin (no trailing slash). The phone talks straight to the API.
# Use the deployed server. TLS (https) is strongly recommended for production.
VITE_API_BASE=http://76.13.248.144:3600

# Shared secret — must equal the server's CENTRALIZATOR_API_KEY.
VITE_CENTRALIZATOR_API_KEY=
