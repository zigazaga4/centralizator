# Get this at https://openrouter.ai/keys — DO NOT commit the real value.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_APP_TITLE=Centralizator
# Shared secret all clients must present via `x-api-key` or `Authorization: Bearer <key>`.
# Unset = dev mode (server runs open with a loud warning). Generate with: openssl rand -hex 32
CENTRALIZATOR_API_KEY=REPLACE_WITH_RANDOM_HEX_SECRET
# Optional: force a specific port. Omit to let the server auto-pick (3000..3099).
# PORT=3000
