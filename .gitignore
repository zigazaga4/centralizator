# Tauri updater signing keys — never commit. The private key is the
# only thing that proves a release is authentic; if it leaks, anyone
# can ship a "Centralizator update" that hijacks every installed app.
# Add the contents of `.keys/centralizator.key` to GitHub Secrets as
# TAURI_SIGNING_PRIVATE_KEY instead.
.keys/

# Build outputs / installed deps
node_modules/
**/node_modules/
**/dist/
**/build/

# Local env files (contain secrets — OpenRouter key + CENTRALIZATOR_API_KEY)
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
**/*.log

# OS / editor cruft
.DS_Store
**/.DS_Store
.idea/
.vscode/

# SQLite working state (not source)
**/centralizator.db
**/centralizator.db-shm
**/centralizator.db-wal

# Auto-generated discovery file
.api-port

# Build artifacts from the server tarball workflow.
centralizator-server.tar.gz
centralizator-server/

# Windows installers checked out at the repo root after a local build.
# The canonical copies live under app/src-tauri/target/.../bundle/nsis/
# and on GitHub Releases.
Centralizator_*_x64-setup.exe
Centralizator_*_x64-setup.exe.sig

# Operator-uploaded pricing source documents — the source-of-truth
# tariffs live in server/src/tariffs.ts, not in these files.
*.docx
*.ods
*.odt
*.xlsx
# Note: *.pdf intentionally NOT ignored here because the repo already
# tracks Centralizator-Formule-de-calcul.pdf.
