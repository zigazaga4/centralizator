# Copy to `.env` and adjust per environment.
#
# VITE_API_BASE is the absolute URL of the Fastify server. Both
# lib/api.ts (extract + reprice) and lib/db.ts (pair queue REST) read
# it at build/dev time, so setting it here is enough to retarget the
# whole client.
#
# Leave it unset to fall back to "/api" — only useful for the local
# dev loop (Vite's `/api/*` proxy + a local server writing .api-port).
VITE_API_BASE=http://76.13.248.144:3600

# Shared API key. Both lib/api.ts and lib/db.ts attach it as
# `x-api-key` on every request EXCEPT /health. Must match
# `CENTRALIZATOR_API_KEY` on the server. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_CENTRALIZATOR_API_KEY=replace-with-32-byte-hex
