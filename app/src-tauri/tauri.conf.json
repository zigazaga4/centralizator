{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Centralizator",
  "version": "0.2.11",
  "identifier": "ro.stalexone.centralizator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Centralizator",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://srv1409671.hstgr.cloud wss://srv1409671.hstgr.cloud http://127.0.0.1:* http://localhost:* http://76.13.248.144:3600 https://github.com https://*.githubusercontent.com ws://127.0.0.1:* ws://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zigazaga4/centralizator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NkJBQjc3QjVFRjQ5OTIKUldTU1NlKzFkNnRyeENpYnV6c2ZkaWY0YXQyNkZIYWpCVVRDYjVkeUJIanp2OGoxeWFJRFlJZ1UK"
    }
  }
}
